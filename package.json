{
  "name": "live.scetrov.tplink",
  "version": "2.0.0",
  "description": "Elgato Stream Deck plugin for controlling TP-Link Kasa and Tapo smart plugs",
  "main": "plugin.js",
  "scripts": {
    "test": "jest --runInBand",
    "lint:md": "markdownlint --config .markdownlint.json '**/*.md'"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.js?(x)"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/__tests__/integration/"
    ]
  },
  "keywords": [
    "stream-deck",
    "elgato",
    "tplink",
    "kasa",
    "tapo",
    "smart-home"
  ],
  "author": "scetrov",
  "license": "MIT",
  "dependencies": {
    "@network-utils/arp-lookup": "^2.1.0",
    "axios": "^1.18.1",
    "macaddr": "^0.1.1",
    "tplink-smarthome-api": "^5.0.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "jest": "^30.4.2",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "js-yaml": "^3.15.0"
  }
}
