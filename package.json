{
  "name": "live.scetrov.tplink",
  "version": "2.0.0",
  "description": "Elgato Stream Deck plugin for controlling TP-Link Kasa and Tapo smart plugs",
  "main": "plugin.js",
  "scripts": {
    "test": "jest --runInBand",
    "lint:md": "markdownlint --config .markdownlint.json '**/*.md'",
    "postinstall": "patch-package"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.js?(x)"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/__tests__/integration/"
    ]
  },
  "keywords": [
    "stream-deck",
    "elgato",
    "tplink",
    "kasa",
    "tapo",
    "smart-home"
  ],
  "author": "scetrov",
  "license": "MIT",
  "dependencies": {
    "patch-package": "8.0.1",
    "tp-link-tapo-connect": "^2.0.15",
    "tplink-smarthome-api": "^5.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "jest": "^30.4.2",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.5"
  },
  "overrides": {
    "axios": "^1.18.1",
    "get-ip-range": "^4.0.1",
    "ip": "npm:@webpod/ip@^0.6.1",
    "ip-address": "^10.2.0",
    "js-yaml": "^3.15.0",
    "uuid": "^11.1.1"
  }
}
