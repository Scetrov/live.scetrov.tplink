{
  "name": "live.scetrov.tplink",
  "version": "2.0.0",
  "description": "Elgato Stream Deck plugin for controlling TP-Link Kasa and Tapo smart plugs",
  "main": "plugin.js",
  "scripts": {
    "test": "jest --runInBand",
    "lint:md": "markdownlint --config .markdownlint.json '**/*.md' || true"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.js?(x)"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/__tests__/integration/"
    ]
  },
  "keywords": [
    "stream-deck",
    "elgato",
    "tplink",
    "kasa",
    "tapo",
    "smart-home"
  ],
  "author": "scetrov",
  "license": "MIT",
  "dependencies": {
    "tp-link-tapo-connect": "^2.0.15",
    "tplink-smarthome-api": "^5.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.5"
  }
}
